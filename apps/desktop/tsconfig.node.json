{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A composite project may not disable emit (TS6310), so it emits declarations only, into
    // a scratch directory nothing reads. The point is the type checking, not the output.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "postcss.config.js"]
}
